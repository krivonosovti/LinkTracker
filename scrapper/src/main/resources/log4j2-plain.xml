<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Логирование в консоль -->
    <appender name="STDOUT_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5p} [%-30.30thread] %style{%X} %-25.25logger{20} -- %highlight{%m} %n</pattern>
        </encoder>
    </appender>

    <!-- Логирование в файл с ротацией -->
    <appender name="FileLogger" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/app-%d{yyyy-MM-dd-HH}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory> <!-- Максимальное количество архивных файлов -->
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %c{1} - %m%n</pattern>
        </encoder>
    </appender>

    <!-- Логеры -->
    <logger name="com.sun" level="WARN"/>
    <logger name="com.zaxxer" level="WARN"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.postgresql" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>
<!--    <logger name="org.springframework.cache" level="WARN"/>-->
    <logger name="org.springframework.security" level="DEBUG"/>
    <logger name="org.springframework.web" level="DEBUG"/>
    <logger name="sun.rmi" level="WARN"/>
    <logger name="sun.rmi.transport" level="WARN"/>

    <!-- Логгер для edu.java -->
    <logger name="edu.java" level="TRACE">
        <appender-ref ref="STDOUT_PLAIN"/>
        <appender-ref ref="FileLogger"/>
    </logger>

    <!-- Главный корневой логгер -->
    <root level="INFO">
        <appender-ref ref="STDOUT_PLAIN"/>
        <appender-ref ref="FileLogger"/>
    </root>

</configuration>
